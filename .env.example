# Vigil — copy to .env and fill in. .env is gitignored; never commit a key.
# Only the model endpoint is required. The four federal data sources are public and keyless.

# ── the model ────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Verified working: MiniMax (https://api.minimax.io/v1,
# model MiniMax-M3) and Commonstack. The model must honour parallel tool calls and a forced
# tool call, because intake's structured output is a forced call.
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3

# A stronger model for the two roles that are real judgement — reading a photo of a shelf, and
# deciding whether four hundred words of recall prose describe YOUR unit. Optional: without it
# every role shares LLM_MODEL.
VIGIL_MODEL_HEAVY=MiniMax-M3

# Per-request output ceiling. Some gateways reserve max_tokens × price against a spend cap and
# reject the whole call if the reservation does not fit, so this stays deliberately modest.
VIGIL_MAX_TOKENS=6000

# How many model calls may be in flight across the whole process, and how many times a
# rate-limited call is retried before it gives up. The graph fans out; this keeps the fan-out
# from tripping a provider's limit.
VIGIL_MODEL_CONCURRENCY=2
VIGIL_MODEL_ATTEMPTS=6

# ── Amazon Bedrock (optional) ────────────────────────────────────────────────
# Set BEDROCK_MODEL_ID and Bedrock becomes the PRIMARY of a Strands ModelRouter, with the
# OpenAI-compatible endpoint above as its FallbackStrategy. Unset, the gateway is used alone.
# Authenticate with the standard AWS credential chain, or with a Bedrock API key.
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# BEDROCK_MODEL_ID_HEAVY=
# AWS_REGION=us-west-2
# AWS_BEARER_TOKEN_BEDROCK=

# ── where things are kept ────────────────────────────────────────────────────
VIGIL_DB_PATH=var/vigil.db
# Responses from the federal APIs, cached on disk with their original fetch time so the UI can
# honestly say "as of".
VIGIL_CACHE_DIR=var/cache
# Strands sessions: a run that halts on a question must outlive the process it started in.
VIGIL_SESSION_DIR=var/sessions
# Every pass records its own event stream here, so a watch can be replayed without re-running it.
VIGIL_PASS_DIR=var/passes

# ── the app ──────────────────────────────────────────────────────────────────
# The public origin. Goes into every redirect; behind a proxy, req.url is the local port.
VIGIL_BASE_URL=http://localhost:3100
# Signs the anonymous owner cookie. Generate one: openssl rand -base64 32
VIGIL_SESSION_SECRET=

# ── the watch ────────────────────────────────────────────────────────────────
# How far back the CPSC consumer-product corpus is pulled. Wider is more thorough and a slower
# first fetch; it is cached for 24h after that.
VIGIL_CPSC_SINCE=2023-01-01
# The sweep (pm2 cron) looks at a household whose last watch is older than this, and at most
# this many households per run.
VIGIL_WATCH_GAP_HOURS=20
VIGIL_MAX_PER_SWEEP=6

# ── tests and tools ──────────────────────────────────────────────────────────
# Set to run the six opt-in tests that actually call the federal APIs.
# VIGIL_LIVE_TESTS=1
# scripts/shoot.mjs borrows Playwright from a sibling checkout rather than adding a dependency.
# PLAYWRIGHT_FROM=/path/to/a/checkout/node_modules/playwright
