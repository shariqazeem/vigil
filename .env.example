# Warden — copy to .env and fill in. .env is gitignored; never commit a key.
#
# Only the model endpoint is required. Everything below it has a working default, and the app
# degrades honestly rather than pretending: with no ssh host it watches local services only, and
# the console always prints which model actually ran a pass.

# ── the model ────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. The deployed instance runs MiniMax-M3 through
# https://api.minimax.io/v1. The model must handle tool calls; nothing here needs vision.
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3

# COMMONSTACK_BASE_URL / COMMONSTACK_API_KEY are read as a fallback for the two above, so an
# existing gateway configuration keeps working without renaming anything.
# COMMONSTACK_BASE_URL=
# COMMONSTACK_API_KEY=

# A stronger model for the two roles that are actual judgement — reading a stack trace against a
# diff (investigate), and deciding what to do about a production system (remedy). Optional:
# without it every role shares LLM_MODEL.
# WARDEN_MODEL_HEAVY=

# Per-request output ceiling. Deliberately modest: some gateways reserve max_tokens × price against
# a spend cap before they will start the request, and reject the whole call if it does not fit.
# Default 3000.
WARDEN_MAX_TOKENS=3000

# One queue for every model call in the process (Strands InvokeModelStage middleware). Several
# incidents can be live at once; this is how many of their model calls may be in flight, and how
# many times a rate-limited call waits and comes back before giving up. Defaults 2 and 6.
WARDEN_MODEL_CONCURRENCY=2
WARDEN_MODEL_ATTEMPTS=6

# ── Amazon Bedrock (optional) ────────────────────────────────────────────────
# Set BEDROCK_MODEL_ID and Bedrock becomes the PRIMARY candidate of a Strands ModelRouter, with the
# OpenAI-compatible endpoint above behind it as a FallbackStrategy. Unset, the gateway is used
# alone — which is what the deployed instance does today.
# Authenticate with the standard AWS credential chain, or with a Bedrock API key.
# BEDROCK_MODEL_ID=
# BEDROCK_MODEL_ID_HEAVY=
# AWS_REGION=us-west-2
# AWS_BEARER_TOKEN_BEDROCK=

# ── where things are kept ────────────────────────────────────────────────────
# The ledger: services, probes, readings, incidents, actions, decisions. Migrations run on first
# open. Default var/warden.db.
WARDEN_DB_PATH=var/warden.db
# Strands sessions on disk. A run that halts on a question must outlive the process it started in.
# Default var/sessions.
WARDEN_SESSION_DIR=var/sessions

# ── the app ──────────────────────────────────────────────────────────────────
# The public origin. Behind a proxy, req.url is the local port, so redirects need this.
WARDEN_BASE_URL=http://localhost:3100
# Signs the anonymous owner cookie. Generate one: openssl rand -base64 32
# Without it the app falls back to a known development secret — set it in production.
WARDEN_SESSION_SECRET=

# ── the watch ────────────────────────────────────────────────────────────────
# scripts/sweep.ts asks every probe, opens an incident when a check has failed enough times in a
# row, and hands the new incident straight to the agent. Set to 0 to sweep and record readings
# without handing anything over — useful while recording, or on a machine you are still trusting.
WARDEN_AUTO_HANDLE=1

# The owner key scripts/warden.ts registers services under. The literal key "demo" is public in the
# console on purpose, so the fleet can be watched without signing in. Default "demo".
WARDEN_OWNER=demo

# Where the demo fleet lives, and the key Warden already holds for it. Operations are handed to
# ssh as argv — never as a composed command line — and one multiplexed connection is reused across
# an investigation. Leave both unset to register local services only.
# WARDEN_HOST=ubuntu@203.0.113.10
# WARDEN_SSH_KEY=/path/to/your/ssh-key

# ── build and tools ──────────────────────────────────────────────────────────
# The VM builds in a sibling directory whose node_modules is a symlink into the live app; Turbopack
# needs its root widened to cover both. Set by scripts/deploy.sh, not by hand.
# WARDEN_TURBO_ROOT=/home/ubuntu
# scripts/shoot.mjs borrows Playwright from a sibling checkout rather than adding a dependency.
# PLAYWRIGHT_FROM=/path/to/a/checkout/node_modules/playwright
